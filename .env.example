# BuildSure AI Environment Configuration

# Database Configuration (PostgreSQL / SQLite)
# For local dev without PostgreSQL docker, leave blank to default to sqlite:///./buildsure.db
DATABASE_URL=postgresql://buildsure:buildsure_pass@localhost:5432/buildsure_db

# Background Tasks & Redis
REDIS_URL=redis://localhost:6379/0

# LLM Reasoning & Report Orchestration
ANTHROPIC_API_KEY=your_anthropic_claude_api_key_here

# Frontend API URL
VITE_API_URL=http://localhost:8000
